{
  "name": "mul-search",
  "version": "2.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "dotenv -e .env.local next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "prismaVer": "dotenv -e .env.development.local -- prisma migrate dev && prisma generate",
    "prismaLocal": "dotenv -e .env.local -- prisma migrate dev && prisma generate",
    "seedLocal": "dotenv -e .env.local -- prisma db seed",
    "test": "tsx --test lib/mul/*.test.ts lib/lists/*.test.ts",
    "mul:backfill": "dotenv -e .env.local -- tsx scripts/mul-backfill.ts",
    "mul:legacy": "dotenv -e .env.local -- tsx scripts/build-legacy-map.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@headlessui/react": "^1.7.18",
    "@heroicons/react": "^2.1.1",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "20.4.10",
    "@types/node-forge": "^1.3.11",
    "@types/react": "18.2.20",
    "@types/react-dom": "18.2.7",
    "autoprefixer": "10.4.14",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.2.0",
    "eslint": "8.47.0",
    "eslint-config-next": "^14.1.2",
    "next": "^14.1.2",
    "next-auth": "^5.0.0-beta.19",
    "pdfjs-dist": "^3.11.174",
    "pg": "^8.23.1",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.13",
    "server-only": "^0.0.1",
    "swr": "^2.2.5",
    "tailwindcss": "^3.4.17",
    "tailwindcss-bg-patterns": "^0.3.0",
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "daisyui": "^4.7.2",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^7.4.4",
    "prisma": "~7.10.0",
    "tsx": "^4.23.15"
  }
}
