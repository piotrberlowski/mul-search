generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Format {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  lists       List[]
  description String
}

model List {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  name        String
  description String?
  format      Format? @relation(fields: [formatId], references: [id])
  formatId    String? @db.Uuid
  content     Json
  constraints String
  total       Int
  createdAt   DateTime @default(now())
  ownerId     String? 
  owner       User? @relation(fields: [ownerId], references: [id])
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  lists         List[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}

// MUL catalog. Integer primary keys are the MUL's own IDs, not autoincrement.

model Era {
  id            Int      @id
  name          String
  slug          String   @unique
  yearStart     Int?
  displayStart  Int?
  yearEnd       Int?
  color         String?
  sort          Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  metadataIntroUnits UnitMetadata[]     @relation("MetadataIntroEra")
  availability       UnitAvailability[]
}

model Faction {
  id           Int      @id
  name         String
  slug         String   @unique
  yearStart    Int?
  yearEnd      Int?
  color        String?
  manufacturer Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  availability UnitAvailability[]

  @@index([name])
}

model UnitType {
  id        Int      @id
  name      String
  slug      String   @unique
  yearStart Int?
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metadataUnits UnitMetadata[]
}

model Ability {
  id        Int      @id
  code      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units UnitAbility[]

  @@index([code])
}

model UnitMetadata {
  id         String    @id
  name       String
  model      String?
  typeId     Int
  type       UnitType  @relation(fields: [typeId], references: [id])
  subType    String?
  introEraId Int?
  introEra   Era?      @relation("MetadataIntroEra", fields: [introEraId], references: [id])
  tonnage    Float?
  pv         Int?
  bv         Int?
  introYear  Int?
  removedAt  DateTime?
  statsUnscrapeableAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  stats        UnitStats?
  abilities    UnitAbility[]
  availability UnitAvailability[]
  legacyIds    LegacyUnitId[]

  @@index([typeId])
  @@index([name])
}

model UnitStats {
  unitId         String       @id
  unit           UnitMetadata @relation(fields: [unitId], references: [id], onDelete: Cascade)
  slug           String       @unique
  size           Int
  move           String?
  tmm            Int?
  armor          Int?
  structure      Int?
  threshold      Int?
  overheat       Int?
  dmgS           String
  dmgM           String
  dmgL           String
  dmgE           String
  specials       String?
  cardVersion    String?
  imageUrl       String?
  sourceLastMod  DateTime?
  statsScrapedAt DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model UnitAbility {
  unitId    String
  abilityId Int
  unit      UnitMetadata @relation(fields: [unitId], references: [id], onDelete: Cascade)
  ability   Ability      @relation(fields: [abilityId], references: [id], onDelete: Cascade)

  @@id([unitId, abilityId])
}

model UnitAvailability {
  unitId    String
  eraId     Int
  factionId Int
  unit      UnitMetadata @relation(fields: [unitId], references: [id], onDelete: Cascade)
  era       Era          @relation(fields: [eraId], references: [id], onDelete: Cascade)
  faction   Faction      @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@id([unitId, eraId, factionId])
  @@index([factionId, eraId])
}

model LegacyUnitId {
  legacyId   Int      @id
  unitId     String
  unit       UnitMetadata @relation(fields: [unitId], references: [id], onDelete: Cascade)
  method     String
  legacyName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([unitId])
}

model SyncRun {
  id               String    @id @default(cuid())
  startedAt        DateTime
  finishedAt       DateTime?
  status           String
  manifestHashes   Json?
  unitsUpserted    Int       @default(0)
  availabilityRows Int       @default(0)
  pagesScraped     Int       @default(0)
  pagesFailed      Int       @default(0)
  errors           Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, startedAt])
}
